<?xml version="1.1" encoding="UTF-8"?>

<channel name="xfce4-notifyd" version="1.0">
  <!-- Redmoon Core — Notification Style v3.0 -->
  <property name="log-max-size-enabled" type="bool"   value="true"/>
  <property name="log-max-size"         type="uint"   value="200"/>
  <property name="initial-timeout"      type="uint"   value="4000"/>
  <property name="do-fadeout"           type="bool"   value="true"/>
  <property name="do-slideout"          type="bool"   value="true"/>
  <property name="notify-location"      type="uint"   value="2"/>
  <property name="theme"                type="string" value="Default"/>
  <property name="expire-timeout"       type="int"    value="5"/>
  <property name="opacity"              type="double" value="0.94"/>
  <property name="applications" type="empty">
    <property name="known_applications" type="array">
      <value type="string" value="notify-send"/>
      <value type="string" value="xfce4-settings-helper"/>
    </property>
  </property>
</channel>
